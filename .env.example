# ── Core ─────────────────────────────────────────
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1

# SQLite by default. For Postgres:
# DATABASE_URL=postgres://user:password@localhost:5432/candles
DATABASE_URL=

# Frontend origins allowed to call the API (comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Razorpay (https://dashboard.razorpay.com → Settings → API Keys) ──
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Email (console backend prints emails in the terminal during development) ──
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Lumière & Co. <hello@lumiere.co.in>
# Where new-order and contact alerts go
STORE_ALERT_EMAIL=hello@lumiere.co.in

# Order number prefix, e.g. LUM10241
ORDER_PREFIX=LUM
